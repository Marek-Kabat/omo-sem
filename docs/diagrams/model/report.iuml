package "report" {
  interface Report {
    + getName() : String
    + generate() : String
  }

  abstract class AbstractReport <<Template Method>> {
    + generate() : String
    # header() : String
    # {abstract} body() : String
    # footer() : String
    # {abstract} getTitle() : String
  }

  class HouseConfigurationReport {
    - house : House
  }
  class EventReport {
    - events : List<Event>
  }
  class ActivityAndUsageReport {
    - activityLog : ActivityLog
  }
  class ConsumptionReport {
    - house : House
    - priceList : PriceList
  }

  class HouseConfigurationVisitor {
    - out : StringBuilder
    - depth : int
  }
  class ConsumptionVisitor {
    - perDevice : Map<Device, Map<ConsumptionType, Double>>
    - totals : EnumMap<ConsumptionType, Double>
  }

  class PriceList {
    - prices : EnumMap<ConsumptionType, BigDecimal>
    + priceOf(type : ConsumptionType, amount : double) : BigDecimal
  }

  enum ReportType {
    HOUSE_CONFIGURATION
    EVENTS
    ACTIVITY_AND_USAGE
    CONSUMPTION
  }

  class ReportFactory <<Factory>> {
    + create(type : ReportType, sim : Simulation) : Report
  }

  class ReportWriter {
    + write(report : Report, dir : Path) : Path
  }

  AbstractReport ..|> Report
  HouseConfigurationReport -up-|> AbstractReport
  EventReport -up-|> AbstractReport
  ActivityAndUsageReport -up-|> AbstractReport
  ConsumptionReport -up-|> AbstractReport
  HouseConfigurationReport ..> HouseConfigurationVisitor
  ConsumptionReport ..> ConsumptionVisitor
  ConsumptionReport --> PriceList
  ReportFactory ..> Report : <<create>>
  ReportFactory ..> ReportType
  ReportWriter ..> Report
}
